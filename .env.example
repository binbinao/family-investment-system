# 运行环境：production 时后端会拒绝使用默认弱数据库口令启动
APP_ENV=production
# 仅当通过 HTTPS 对外提供服务时置为 true（默认 nginx 走 HTTP，置 true 会导致登录 Cookie 失效）
COOKIE_SECURE=false

# Nginx 对外端口（本机 80/8080 被占用时可改为 8888 等）
NGINX_HOST_PORT=80

# PostgreSQL（PASSWORD 必填，请设置强口令，切勿使用 postgres/changeme 等默认值）
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=family_invest

# Redis 访问口令（必填，请设置强口令）
REDIS_PASSWORD=

# DeepSeek 官方 API（与下方第三方二选一或仅用官方）
DEEPSEEK_API_KEY=
# 可写 https://api.deepseek.com（无 /v1）；后端会规范为 OpenAI SDK 所需的 …/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 第三方 DeepSeek 兼容网关（OpenAI 接口格式，如聚合平台、自建转发等）
# 任一项填写后：API Key / Base URL / Model 均优先使用本组；未填的项回退到上方 DEEPSEEK_*
DEEPSEEK_VENDOR_API_KEY=
# 示例：https://api.example.com 或 https://api.example.com/v1（尾斜杠会自动去掉；无 /v1 时会自动补上）
DEEPSEEK_VENDOR_BASE_URL=
# 第三方处登记的模型名，不填则用 DEEPSEEK_MODEL
DEEPSEEK_VENDOR_MODEL=
